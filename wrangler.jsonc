{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "ivanovishado-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-25",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "www.ivanovishado.dev/*", "zone_id": "4182653a07a8b9def933953ba15912d7" },
    { "pattern": "ivanovishado.dev/*", "zone_id": "4182653a07a8b9def933953ba15912d7" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/index.md",
      "/resume",
      "/resume/*",
      "/resume.md",
      "/mentorship",
      "/mentorship/*",
      "/mentorship.md",
      "/work/*",
      "/trajectory",
      "/trajectory/*",
      "/trajectory.md",
      "/shelf",
      "/shelf/*",
      "/shelf.md",
      "/privacy",
      "/privacy/*",
      "/privacy.md",
      "/mcp",
      "/mcp/*",
      "/.well-known/*",
      "/llms.txt",
      "/llms-full.txt",
      "/sitemap.md"
    ]
  }
}
